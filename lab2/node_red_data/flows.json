        "z": "882724fcf6f40ec6",
        "name": "function 5",
        "func": "const chatId = msg.payload.chatId;\nconst text = msg.payload.content;\n\nlet reply = \"\";\n\nif (text === \"/start\") {\n    reply = \"Привет! Я бот студентки Сотниковой для лабы №2.\";\n} else if (text === \"/help\") {\n    reply = \"Я знаю команды: /start, /help. А если напишешь что-то другое — я повторю это эхом!\";\n} else {\n    reply = \"Эхо от Сотниковой: \" + text;\n}\n\nmsg.payload = {\n    chatId: chatId,\n    type: \"message\",\n    content: reply\n};\n\nreturn msg;",
